function loadData($file, &$target, $default = []) {
    global $dataPath;
    $path = $dataPath . $file;
    if (file_exists($path)) {
        $target = json_decode(file_get_contents($path), true) ?? $default;
    } else {
        $target = $default;
    }
}

function saveData($file, $data) {
    global $dataPath;
    file_put_contents($dataPath . $file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
}

loadData('bot.json', $botData);
loadData('app.json', $appData);
loadData('subscription.json', $subscriptionData);
