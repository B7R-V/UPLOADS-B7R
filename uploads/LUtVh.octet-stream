    $method = $data ? 'editMessageText' : 'sendMessage';
    $markup = null;
    if ($botData['VIP_button'] == 'on') {
        $markup = json_encode(['inline_keyboard' => [[['text' => 'طلب اشتراك VIP', 'callback_data' => 'vip']]]]);
    }
