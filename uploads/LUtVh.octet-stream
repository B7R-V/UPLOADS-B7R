        exit;
    }
    $totalFolders = 0;
    $totalFiles = 0;
    $list = '';
    foreach ($items as $item) {
        if (strpos($item, '📂') !== false) $totalFolders++;
        else $totalFiles++;
        $list .= "- {$item}\n";
    }
    $display = implode("\n", array_slice(explode("\n", $list), 0, 10));
    $msg = "*المجلدات:* {$totalFolders}\n*الملفات:* {$totalFiles}\n\n{$display}";
    bot('editMessageText', ['chat_id' => $chatId, 'message_id' => $messageId, 'text' => $msg, 'parse_mode' => 'markdown', 'reply_markup' => json_encode(['inline_keyboard' => [[['text' => 'رجوع', 'callback_data' => 'back2']]]])]);
    exit;
}

