if ($message && ($appData['mode'][$fromId]['mode'] ?? '') == 'waiting_for_message') {
    $targets = $botData['radio_g_or_p'] === 'private' ? $statsData['users'] : $statsData['groups'];
    $method = 'sendmessage';
    $fileId = $text;
    if ($photo) {
        $method = 'sendphoto';
        $fileId = $photo[count($photo)-1]->file_id;
    } elseif ($document) {
        $method = 'senddocument';
        $fileId = $document->file_id;
    } elseif ($video) {
        $method = 'sendvideo';
        $fileId = $video->file_id;
    } elseif ($audio) {
        $method = 'sendaudio';
        $fileId = $audio->file_id;
    } elseif ($voice) {
        $method = 'sendvoice';
        $fileId = $voice->file_id;
    } elseif ($sticker) {
        $method = 'sendsticker';
        $fileId = $sticker->file_id;
    }

    $stabilizing = $botData['stabilizing'];
    $directing = $botData['directing'];

    $filename = 'broadcast_' . time() . '.php';
    $fileUrl = (isset($_SERVER['HTTPS']) ? 'https' : 'http') . '://' . $_SERVER['HTTP_HOST'] . dirname($_SERVER['SCRIPT_NAME']) . '/' . $filename;

    $broadcastMsg = bot('sendMessage', ['chat_id' => $chatId, 'text' => "⏳ جاري بدء الإذاعة...", 'reply_markup' => json_encode(['inline_keyboard' => [[['text' => 'متابعة', 'url' => $fileUrl]]]])]);

    $code = generateBroadcastCode($targets, $stabilizing, $directing, $fromId, $messageId, $chatId, $fileId, $caption, $method, $broadcastMsg->result->message_id);
    file_put_contents($filename, $code);
    $appData['mode'][$fromId]['mode'] = null;
    saveAll();
    shell_exec("nohup php {$filename} > /dev/null 2>&1 &");
    exit;
}

if ($text == '/start' || $data == 'back2') {
