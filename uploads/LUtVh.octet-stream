if ($document && $botData['upload'] == 'on') {
    if ($botData['premium'] == 'on' && !isAdmin($fromId) && !isVip($fromId)) {
        bot('sendMessage', ['chat_id' => $chatId, 'text' => "💰 هذا البوت مدفوع، يرجى الاشتراك لرفع الملفات."]);
        exit;
    }
    if (isset($botData['from_php'][$fromId]) && $botData['from_php'][$fromId] >= $botData['numberfiles']) {
        bot('sendMessage', ['chat_id' => $chatId, 'text' => "⚠️ لقد تجاوزت الحد الأقصى للملفات المسموح بها ({$botData['numberfiles']}).\nعدد ملفاتك: {$botData['from_php'][$fromId]}", 'reply_markup' => json_encode(['inline_keyboard' => [[['text' => 'حذف جميع ملفاتك', 'callback_data' => "delete_file_all|{$fromId}"]]]])]);
        exit;
    }

    $fileInfo = bot('getFile', ['file_id' => $documentFileId]);
    $fileUrl = "https://api.telegram.org/file/bot" . API_KEY . "/" . $fileInfo->result->file_path;
    $content = file_get_contents($fileUrl);
    $tempFile = "check/{$chatId}.php";
    file_put_contents($tempFile, $content);

    $extension = pathinfo($documentFileName, PATHINFO_EXTENSION);
    $isMalicious = false;
    $banMessage = '';

    if ($extension == 'php') {
        $msg = bot('sendMessage', ['chat_id' => $chatId, 'text' => "⏳ جاري فحص الملف..."]);
        if (checkFileContent($content)) {
            $isMalicious = true;
            $banMessage = generateBanMessage($fromId);
            $botData['from_ban'][$fromId] = ($botData['from_ban'][$fromId] ?? 0) + 1;
            $botData['php_ban']++;
            $botData['ban']++;
            saveAll();
            bot('sendMessage', ['chat_id' => ADMIN_ID, 'text' => "*⚠️ محاولة اختراق*\nمن: [{$firstName}](tg://user?id={$fromId})\nايدي: {$fromId}", 'parse_mode' => 'markdown']);
        } else {
            $botData['from_php'][$fromId] = ($botData['from_php'][$fromId] ?? 0) + 1;
            $botData['php']++;
            $botData['file']++;
            $path = getCurrentFolder($fromId) . '/' . $documentFileName;
            file_put_contents($path, $content);
            if (strpos($content, 'api.telegram.org') !== false) {
                $botData['Info_uploads']['telegram']++;
            } else {
                $botData['Info_uploads']['not_telegram']++;
            }
            if (strpos($content, 'curl_') !== false) {
                $botData['Info_uploads']['curl']++;
            }
            saveAll();
            $link = getFileLink($documentFileName, $fromId);
            $token = extractToken($content);
            $cr = rand(9999, 999999);
            $botData['Info_from_upload'][$cr]['url'] = $path;
            if ($token) {
                $botData['Info_from_upload'][$cr]['token'] = $token;
                $botData['Info_from_upload'][$cr]['webhook'] = urlencode($link);
                saveAll();
                $keyboard = [
                    [['text' => 'تعيين ويب هوك', 'callback_data' => "up_webhook|{$cr}"], ['text' => 'حذف ويب هوك', 'callback_data' => "del_webhook|{$cr}"]],
                    [['text' => 'حذف الملف', 'callback_data' => "delete_file|{$cr}"]],
                    [['text' => 'معلومات البوت', 'callback_data' => "information_bot|{$cr}"]],
                    [['text' => 'حذف جميع ملفاتي', 'callback_data' => "delete_file_all|{$fromId}"]]
                ];
            } else {
                $keyboard = [
                    [['text' => 'حذف الملف', 'callback_data' => "delete_file|{$cr}"]],
                    [['text' => 'حذف جميع ملفاتي', 'callback_data' => "delete_file_all|{$fromId}"]]
                ];
            }
            $msgText = "✅ تم رفع الملف بنجاح\n📁 المسار: {$botData['from_folder']}\n🔗 رابط الويب هوك: `" . ($token ? $link : 'لا يوجد') . "`\n🔑 التوكن: `" . ($token ? $token : 'لا يوجد') . "`";
            bot('editMessageText', ['chat_id' => $chatId, 'message_id' => $msg->result->message_id, 'text' => $msgText, 'parse_mode' => 'markdown', 'reply_markup' => json_encode(['inline_keyboard' => $keyboard])]);
            bot('sendMessage', ['chat_id' => ADMIN_ID, 'text' => "📤 تم رفع ملف من [{$firstName}](tg://user?id={$fromId})\nالمسار: {$botData['from_folder']}\nالرابط: {$link}\nالتوكن: `{$token}`", 'parse_mode' => 'markdown']);
        }
        unlink($tempFile);
        if ($isMalicious) {
            bot('editMessageText', ['chat_id' => $chatId, 'message_id' => $msg->result->message_id, 'text' => $banMessage, 'parse_mode' => 'markdown']);
        }
    } elseif ($extension == 'json') {
        $data = json_decode($content, true);
        if ($data === null) {
            bot('sendMessage', ['chat_id' => $chatId, 'text' => "❌ ملف JSON غير صالح."]);
            exit;
        }
        $suspicious = ['ZipArchive', 'zip', 'eval', '.php', 'base64', 'base64_decode', 'github', 'public function create', 'include', 'shell', 'system', 'timestamper', '__FILE__'];
        foreach ($data as $key => $value) {
            foreach ($suspicious as $word) {
                if (strpos($value, $word) !== false || strpos($key, $word) !== false) {
                    $botData['from_ban'][$fromId] = ($botData['from_ban'][$fromId] ?? 0) + 1;
                    $botData['json_ban']++;
                    $botData['ban']++;
                    saveAll();
                    bot('sendMessage', ['chat_id' => ADMIN_ID, 'text' => "*⚠️ محاولة اختراق (JSON)*\nمن: [{$firstName}](tg://user?id={$fromId})", 'parse_mode' => 'markdown']);
                    bot('sendMessage', ['chat_id' => $chatId, 'text' => generateBanMessage($fromId), 'parse_mode' => 'markdown']);
                    exit;
                }
            }
        }
        $path = getCurrentFolder($fromId) . '/' . $documentFileName;
        file_put_contents($path, $content);
        $botData['from_json'][$fromId] = ($botData['from_json'][$fromId] ?? 0) + 1;
        $botData['json']++;
        $botData['file']++;
        saveAll();
        bot('sendMessage', ['chat_id' => $chatId, 'text' => "✅ تم رفع ملف JSON بنجاح."]);
    } elseif ($extension == 'txt') {
        $suspicious = ['ZipArchive', 'zip', 'eval', '.php', 'base64', 'base64_decode', 'github', 'public function create', 'include', 'shell', 'system', 'timestamper', '__FILE__'];
        foreach ($suspicious as $word) {
            if (strpos($content, $word) !== false) {
                $botData['from_ban'][$fromId] = ($botData['from_ban'][$fromId] ?? 0) + 1;
                $botData['text_ban']++;
                $botData['ban']++;
                saveAll();
                bot('sendMessage', ['chat_id' => ADMIN_ID, 'text' => "*⚠️ محاولة اختراق (TXT)*\nمن: [{$firstName}](tg://user?id={$fromId})", 'parse_mode' => 'markdown']);
                bot('sendMessage', ['chat_id' => $chatId, 'text' => generateBanMessage($fromId), 'parse_mode' => 'markdown']);
                exit;
            }
        }
        $path = getCurrentFolder($fromId) . '/' . $documentFileName;
        file_put_contents($path, $content);
        $botData['from_text'][$fromId] = ($botData['from_text'][$fromId] ?? 0) + 1;
        $botData['text']++;
        $botData['file']++;
        saveAll();
        bot('sendMessage', ['chat_id' => $chatId, 'text' => "✅ تم رفع ملف TXT بنجاح."]);
    }
}

function generateBanMessage($userId) {
    global $botData;
    $limit = $botData['numberban'] ?? 3;
    $warnings = $botData['from_ban'][$userId] ?? 0;
    $remaining = $limit - $warnings;
    if ($remaining <= 0) {
        return "🚫 تم حظرك نهائياً لتجاوزك عدد التحذيرات المسموح به.";
    }
    return "⚠️ تحذير: محاولة رفع ملف مخالف.\nتبقى لديك {$remaining} تحذير من {$limit}.";
}

function extractToken($content) {
    if (preg_match('/(\d{6,14}:[\w-]{35,75})/', $content, $matches)) {
        $token = $matches[0];
        $result = file_get_contents("https://api.telegram.org/bot{$token}/getme");
        if ($result !== false) {
            return $token;
        }
    }
    return null;
}

$actionParts = explode('|', $data ?? '');
$command = $actionParts[0] ?? '';
$param = $actionParts[1] ?? null;

if ($command == 'up_webhook') {
    $cr = $param;
    $token = $botData['Info_from_upload'][$cr]['token'] ?? null;
    $url = $botData['Info_from_upload'][$cr]['webhook'] ?? null;
    if ($token && $url) {
        file_get_contents("https://api.telegram.org/bot{$token}/setwebhook?url={$url}");
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '✅ تم تعيين ويب هوك', 'show_alert' => true]);
        sendMessage("✅ تم تعيين ويب هوك بنجاح.\n" . OWNER_TEXT, $fromId, $token);
    } else {
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '❌ خطأ في البيانات', 'show_alert' => true]);
    }
    exit;
}

if ($command == 'del_webhook') {
    $cr = $param;
    $token = $botData['Info_from_upload'][$cr]['token'] ?? null;
    if ($token) {
        file_get_contents("https://api.telegram.org/bot{$token}/deleteWebhook");
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '✅ تم حذف ويب هوك', 'show_alert' => true]);
        sendMessage("✅ تم حذف ويب هوك بنجاح.\n" . OWNER_TEXT, $fromId, $token);
    } else {
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '❌ خطأ في البيانات', 'show_alert' => true]);
    }
    exit;
}

if ($command == 'information_bot') {
    $cr = $param;
    $token = $botData['Info_from_upload'][$cr]['token'] ?? null;
    if ($token) {
        $res = file_get_contents("https://api.telegram.org/bot{$token}/getMe");
        $info = json_decode($res);
        if ($info && $info->ok) {
            $bot = $info->result;
            $msg = "🤖 *معلومات البوت*\n";
            $msg .= "الاسم: {$bot->first_name}\n";
            $msg .= "اليوزر: @{$bot->username}\n";
            $msg .= "ايدي: {$bot->id}\n";
            $msg .= "خاص: " . ($bot->can_join_groups ? 'عام' : 'خاص');
            bot('sendMessage', ['chat_id' => $chatId, 'text' => $msg, 'parse_mode' => 'markdown']);
        } else {
            bot('sendMessage', ['chat_id' => $chatId, 'text' => '❌ توكن غير صحيح']);
        }
    } else {
        bot('sendMessage', ['chat_id' => $chatId, 'text' => '❌ لا يوجد توكن لهذا الملف']);
    }
    exit;
}

if ($command == 'delete_file') {
    $cr = $param;
    $path = $botData['Info_from_upload'][$cr]['url'] ?? null;
    if ($path && file_exists($path)) {
        unlink($path);
        unset($botData['Info_from_upload'][$cr]);
        if (isset($botData['from_php'][$fromId])) {
            $botData['from_php'][$fromId]--;
        }
        saveAll();
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '✅ تم حذف الملف', 'show_alert' => true]);
    } else {
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '❌ الملف غير موجود', 'show_alert' => true]);
    }
    exit;
}

if ($command == 'delete_file_all') {
    $userId = $param;
    $folder = getUserFolder($userId);
    if (is_dir($folder)) {
        if (deleteFolderRecursive($folder)) {
            bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '✅ تم حذف جميع ملفاتك', 'show_alert' => true]);
        } else {
            bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '❌ حدث خطأ أثناء الحذف', 'show_alert' => true]);
        }
    } else {
        bot('answerCallbackQuery', ['callback_query_id' => $callback->id, 'text' => '❌ لا توجد ملفات', 'show_alert' => true]);
    }
    exit;
}

saveAll();