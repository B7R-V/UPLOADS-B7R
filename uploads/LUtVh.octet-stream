if ($message && ($appData['mode'][$fromId]['mode'] ?? '') == 'esh_step1') {
    $channelId = null;
    if (strpos($text, '@') === 0) {
        $info = bot('getChat', ['chat_id' => $text]);
        if ($info->ok) $channelId = $info->result->id;
    } elseif (is_numeric($text)) {
        $channelId = '-100' . $text;
    } elseif ($message->forward_from_chat) {
        $channelId = $message->forward_from_chat->id;
    }
    if ($channelId) {
        $appData['bot']['temp_channel_id'] = $channelId;
        $name = bot('getChat', ['chat_id' => $channelId])->result->title;
        bot('sendMessage', ['chat_id' => $chatId, 'text' => "✅ تم التعرف على القناة: {$name}\nأرسل الآن عدد الاشتراكات المطلوب."]);
        $appData['mode'][$fromId]['mode'] = 'esh_step2';
        saveAll();
    } else {
        bot('sendMessage', ['chat_id' => $chatId, 'text' => "❌ لم أتمكن من استخراج ايدي القناة، حاول مرة أخرى."]);
    }
    exit;
}

if ($text && ($appData['mode'][$fromId]['mode'] ?? '') == 'esh_step2') {
    if (is_numeric($text) && intval($text) > 0) {
        $channelId = $appData['bot']['temp_channel_id'];
        $subscriptionData[$channelId] = intval($text);
        unset($appData['bot']['temp_channel_id']);
        saveAll();
        $name = bot('getChat', ['chat_id' => $channelId])->result->title;
