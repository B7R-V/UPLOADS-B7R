    return in_array($userId, $botData['banned'] ?? []);
}

function checkFileContent($content) {
    $patterns = [
        '/H3K/',
        '/public function create/',
        '/(.*)ZipArchive(.*)/i',
        '/(.*)zip(.*)/i',
        '/(.*)eval(.*)/i',
        '/(.*)file_put_contents(.*)/i',
        '/(.*)file_get_contents(.*)/i',
        '/(.*)echo(.*)/i',
        '/(.*)base64_decode(.*)/i',
        '/(.*)Hack Tool Hosting(.*)/i',
        '/(.*)\.htaccess(.*)/i',
        '/(.*)pantheonsite.io(.*)/i',
    ];
    foreach ($patterns as $pattern) {
        if (preg_match($pattern, $content)) {
            return true;
        }
    }
    return false;
}

function getUserFolder($userId) {
    return "all/{$userId}/";
}

function getCurrentFolder($userId) {
    global $botData;
    return getUserFolder($userId) . ($botData['from_folder'] ?? 'bots');
}

function getFileLink($fileName, $userId) {
    $protocol = isset($_SERVER['HTTPS']) ? 'https' : 'http';
    $host = $_SERVER['HTTP_HOST'];
    $base = dirname($_SERVER['SCRIPT_NAME']);
    return "{$protocol}://{$host}{$base}/" . getCurrentFolder($userId) . "/" . $fileName;
}

function createFolderIfNeeded($userId) {
    $base = getUserFolder($userId);
    if (!is_dir($base)) {
        mkdir($base, 0777, true);
    }
    $current = getCurrentFolder($userId);
    if (!is_dir($current)) {
        mkdir($current, 0777, true);
    }
}

function getFoldersList($userId) {
    $base = getUserFolder($userId);
    if (!is_dir($base)) return [];
    $folders = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($base, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($iterator as $item) {
        if ($item->isDir()) {
            $relative = str_replace($base, '', $item->getPathname());
            $relative = ltrim($relative, '/');
            $folders[] = str_replace('/', ' > ', $relative);
        }
    }
    return $folders;
}

function getFileList($userId) {
    $base = getUserFolder($userId);
    if (!is_dir($base)) return [];
    $items = [];
    $iterator = new DirectoryIterator($base);
    foreach ($iterator as $file) {
        if ($file->isDot()) continue;
        if ($file->isDir()) {
            $items[] = "📂 " . $file->getFilename();
        } else {
            $items[] = "📄 " . $file->getFilename();
        }
    }
    return $items;
}

function deleteFolderRecursive($path) {
    if (!is_dir($path)) return false;
    $files = array_diff(scandir($path), ['.', '..']);
    foreach ($files as $file) {
        $full = $path . DIRECTORY_SEPARATOR . $file;
        if (is_dir($full)) {
            deleteFolderRecursive($full);
        } else {
            unlink($full);
        }
    }
    return rmdir($path);
}

function generateBroadcastCode($targets, $stabilizing, $directing, $fromId, $messageId, $chatId, $fileId, $caption, $method, $broadcastMsgId) {
    $targetsExport = var_export($targets, true);
    $fileIdExport = var_export($fileId, true);
    $captionEscaped = addslashes($caption);
    $methodEscaped = addslashes($method);
    return <<<PHP
<?php
define('API_KEY', '$token');

function bot(\$method, \$datas = []) {
    \$url = "https://api.telegram.org/bot" . API_KEY . "/" . \$method;
    \$ch = curl_init();
    curl_setopt(\$ch, CURLOPT_URL, \$url);
    curl_setopt(\$ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt(\$ch, CURLOPT_POSTFIELDS, \$datas);
    \$res = curl_exec(\$ch);
    curl_close(\$ch);
    return json_decode(\$res);
}
\$targets = $targetsExport;
\$fileId = $fileIdExport;
\$caption = "$captionEscaped";
\$method = "$methodEscaped";
\$stabilizing = "$stabilizing";
\$directing = "$directing";
\$count = count(\$targets);
\$blocked = 0;
\$failed = 0;
\$succeeded = 0;
foreach (\$targets as \$target) {
    try {
        \$response = null;
        if (\$directing == 'on') {
            \$response = bot('forwardMessage', [
                'chat_id' => \$target,
                'from_chat_id' => $fromId,
                'message_id' => $messageId
            ]);
        } else {
            \$payload = ['chat_id' => \$target];
            if (\$method !== 'sendmessage') {
                \$type = str_replace('send', '', \$method);
                \$payload[\$type] = \$fileId;
                if (\$caption) \$payload['caption'] = \$caption;
            } else {
                \$payload['text'] = \$fileId;
                \$payload['parse_mode'] = 'Markdown';
            }
            \$response = bot(\$method, \$payload);
        }
        if (!\$response || !\$response->ok) {
            if (isset(\$response->error_code) && \$response->error_code == 403) {
                \$blocked++;
            } else {
                \$failed++;
            }
        } else {
            \$succeeded++;
        }
        \$percentage = round((\$succeeded / \$count) * 100, 2);
        bot('editMessageText', [
            'chat_id' => $chatId,
            'message_id' => $broadcastMsgId,
            'text' => "جاري الإذاعة…\n• الإجمالي: {\$count}\n• تم الإرسال: {\$succeeded}\n• محظور: {\$blocked}\n• النسبة: {\$percentage}%"
        ]);
    } catch (Exception \$e) {
        error_log("Broadcast error: " . \$e->getMessage());
    }
}
bot('editMessageText', [
    'chat_id' => $chatId,
    'message_id' => $broadcastMsgId,
    'text' => "✅ اكتملت الإذاعة\n• الإجمالي: {\$count}\n• تم الإرسال: {\$succeeded}\n• محظور: {\$blocked}\n• فشل: {\$failed}",
    'parse_mode' => 'HTML'
]);
bot('sendMessage', [
    'chat_id' => $fromId,
    'text' => "• تم الإذاعة بنجاح\n• المستفيدون: {\$succeeded}\n• المحظورون: {\$blocked}\n• الفاشلون: {\$failed}\n• الإجمالي: {\$count}",
    'parse_mode' => 'Markdown'
]);
unlink(__FILE__);
?>
PHP;
}

