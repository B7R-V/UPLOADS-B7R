    exit;
}

if (!isAdmin($fromId) && !isVip($fromId) && !empty($subscriptionData)) {
    $missing = [];
    $subscribed = true;
    foreach ($subscriptionData as $channelId => $required) {
        $response = callAPI('check', $channelId, $fromId);
        if (!$response['subscribed']) {
            $missing[$channelId] = $required;
            $subscribed = false;
            if (!isset($appData[$channelId]['members'])) $appData[$channelId]['members'] = [];
            if (!in_array($fromId, $appData[$channelId]['members'])) {
                $appData[$channelId]['members'][] = $fromId;
                saveAll();
            }
        } else {
            if (isset($appData[$channelId]['members']) && in_array($fromId, $appData[$channelId]['members'])) {
                unset($appData[$channelId]['members'][array_search($fromId, $appData[$channelId]['members'])]);
                if (!isset($appData[$channelId]['nom'])) $appData[$channelId]['nom'] = 0;
                $appData[$channelId]['nom']++;
                saveAll();
                $channelName = bot('getChat', ['chat_id' => $channelId])->result->title;
                $current = $appData[$channelId]['nom'];
                $msg = "✅ اشتراك جديد في قناة {$channelName}\nالاسم: {$firstName}\nالعدد: {$current}/{$required}";
                if ($current >= $required) {
                    $msg .= "\n✅ اكتمل العدد المطلوب لهذه القناة.";
                    unset($subscriptionData[$channelId]);
                    unset($appData[$channelId]);
                    saveAll();
                }
                bot('sendMessage', ['chat_id' => ADMIN_ID, 'text' => $msg]);
            }
        }
    }
    if (!$subscribed) {
        $buttons = [];
        foreach ($missing as $channelId => $required) {
            $chat = bot('getChat', ['chat_id' => $channelId]);
            $name = $chat->result->title;
            if (!isset($appData[$channelId]['link'])) {
                $response = callAPI('link', $channelId, null, $required);
                if (isset($response['link'])) {
                    $appData[$channelId]['link'] = $response['link'];
                    saveAll();
                } else {
                    bot('sendMessage', ['chat_id' => $chatId, 'text' => "⚠️ حدث خطأ في إنشاء رابط الدعوة، يرجى التواصل مع المطور."]);
                    exit;
                }
            }
            $buttons[] = [['text' => "اشترك في {$name}", 'url' => $appData[$channelId]['link']]];
        }
        $msg = "يرجى الاشتراك في القنوات التالية للمتابعة:";
        $markup = json_encode(['inline_keyboard' => $buttons]);
        if ($data) {
            bot('editMessageText', ['chat_id' => $chatId, 'message_id' => $messageId, 'text' => $msg, 'parse_mode' => 'markdown', 'reply_markup' => $markup]);
        } else {
            bot('sendMessage', ['chat_id' => $chatId, 'text' => $msg, 'parse_mode' => 'markdown', 'reply_markup' => $markup]);
        }
        exit;
    }
}

