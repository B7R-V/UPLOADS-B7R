    saveData('bot.json', $botData);
    saveData('app.json', $appData);
    saveData('subscription.json', $subscriptionData);
    saveData('statistics.json', $statsData);
}

function bot($method, $datas = []) {
    $url = "https://api.telegram.org/bot" . API_KEY . "/" . $method;
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, $datas);
    $res = curl_exec($ch);
    curl_close($ch);
    return json_decode($res);
}

function callAPI($action, $channelId, $userId = null, $number = 1) {
    $apiUrl = 'https://abdomoh.serv00.net/api/eshterak_api.php';
    $data = ['action' => $action, 'channel_id' => $channelId];
    if ($action === 'check' && $userId !== null) {
        $data['user_id'] = $userId;
    }
    if ($action === 'link') {
        $data['number'] = $number;
    }
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $apiUrl);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
    curl_setopt($ch, CURLOPT_HTTPHEADER, ['Content-Type: application/json']);
    $response = curl_exec($ch);
    curl_close($ch);
    return json_decode($response, true);
}

function sendMessage($text, $chatId, $token = API_KEY) {
    $url = "https://api.telegram.org/bot{$token}/sendMessage?chat_id={$chatId}&text=" . urlencode($text) . "&parse_mode=markdown";
    file_get_contents($url);
}

